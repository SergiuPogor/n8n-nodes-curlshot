{
	"name": "n8n-nodes-curlshot",
	"version": "0.1.0",
	"description": "Take website screenshots, PDFs and scrolling videos in n8n workflows with the CurlShot API.",
	"license": "MIT",
	"homepage": "https://curlshot.com/docs/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"screenshot",
		"screenshot-api",
		"pdf",
		"html-to-image",
		"website-screenshot",
		"curlshot"
	],
	"author": {
		"name": "CurlShot",
		"email": "support@curlshot.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SergiuPogor/n8n-nodes-curlshot.git"
	},
	"bugs": {
		"url": "https://github.com/SergiuPogor/n8n-nodes-curlshot/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CurlShotApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CurlShot/CurlShot.node.js",
			"dist/nodes/CurlShotTrigger/CurlShotTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.2",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "5.0.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
